# 비워 두면 로컬 파일 PostgreSQL(PGlite, data/ 폴더)을 사용. 배포 시 실제 PostgreSQL 주소
DATABASE_URL=
# 환자 로그인 토큰 서명용 (아무 긴 문자열)
JWT_SECRET=change-me-to-a-long-random-string
# 프론트 주소 (쉼표로 여러 개)
CORS_ORIGINS=http://localhost:3300,http://localhost:3400
PORT=4100
# 시연 데이터 초기화 허용 (배포에서는 false)
ALLOW_RESET=true
# AI 답변 문장 생성용. 비워 두면 병원 자료 원문으로 답함. GitHub에 올리지 않음
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Dify 챗봇 앱의 API 키 (있으면 Dify로 답함, 없으면 위 OpenAI 키로 직접 검색). GitHub에 올리지 않음
DIFY_API_KEY=
DIFY_API_URL=https://api.dify.ai/v1
# 어드민에서 올린 자료를 Dify 지식에도 추가할 때 (지식 API 키, 지식 ID)
DIFY_DATASET_KEY=
DIFY_DATASET_ID=
# 다른 과제와 같은 DB를 쓸 때 미소치과 테이블을 둘 스키마
DB_SCHEMA=miso
