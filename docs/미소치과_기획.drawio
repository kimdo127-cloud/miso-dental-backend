<mxGraphModel adaptiveColors="auto"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="a_sec" value="AS-IS 업무 흐름 (고객 자료 기준 + 🎤 인터뷰)" style="rounded=0;html=1;fontSize=22;fontStyle=1;align=left;spacingLeft=12;fillColor=#1F2A44;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1900" height="44" as="geometry"/></mxCell><mxCell id="a_lane0" value="" style="rounded=0;html=1;fillColor=#F5F9FF;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="90" y="54" width="600" height="1190" as="geometry"/></mxCell><mxCell id="a_lh0" value="&lt;b&gt;환자&lt;/b&gt;" style="rounded=0;html=1;fontSize=15;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="90" y="54" width="600" height="36" as="geometry"/></mxCell><mxCell id="a_lane1" value="" style="rounded=0;html=1;fillColor=#F8FCF6;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="690" y="54" width="600" height="1190" as="geometry"/></mxCell><mxCell id="a_lh1" value="&lt;b&gt;데스크 (한 실장)&lt;/b&gt;" style="rounded=0;html=1;fontSize=15;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="690" y="54" width="600" height="36" as="geometry"/></mxCell><mxCell id="a_lane2" value="" style="rounded=0;html=1;fillColor=#F8FCF6;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1290" y="54" width="600" height="1190" as="geometry"/></mxCell><mxCell id="a_lh2" value="&lt;b&gt;원장 · 치과위생사&lt;/b&gt;" style="rounded=0;html=1;fontSize=15;fillColor=#D5E8D4;strokeColor=#82B366;" vertex="1" parent="1"><mxGeometry x="1290" y="54" width="600" height="36" as="geometry"/></mxCell><mxCell id="a_ph0" value="&lt;b&gt;① 예약&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#F2F4F7;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="0" y="89" width="84" height="290" as="geometry"/></mxCell><mxCell id="a_ph1" value="&lt;b&gt;② 내원·진료&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#F2F4F7;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="0" y="389" width="84" height="190" as="geometry"/></mxCell><mxCell id="a_ph2" value="&lt;b&gt;③ 진료 후 안내&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#F2F4F7;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="0" y="589" width="84" height="90" as="geometry"/></mxCell><mxCell id="a_ph3" value="&lt;b&gt;④ 진료 후 문의&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#F2F4F7;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="0" y="689" width="84" height="190" as="geometry"/></mxCell><mxCell id="a_ph4" value="&lt;b&gt;⑤ 정기 검진&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=13;fillColor=#F2F4F7;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="0" y="1019" width="84" height="190" as="geometry"/></mxCell><mxCell id="a_r1" value="전화·네이버로 예약 요청&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#8A94A6&quot;&gt;전화 · 네이버 예약&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="104" width="240" height="60" as="geometry"/></mxCell><mxCell id="a_r2" value="진료 프로그램에 옮겨 적기&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#8A94A6&quot;&gt;진료 프로그램&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="720" y="204" width="240" height="60" as="geometry"/></mxCell><mxCell id="a_r3" value="예약 보고 시술 준비물 준비&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#8A94A6&quot;&gt;진료 프로그램&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1320" y="304" width="240" height="60" as="geometry"/></mxCell><mxCell id="a_r4" value="예약일 내원" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="404" width="240" height="60" as="geometry"/></mxCell><mxCell id="a_r5" value="진료·시술, 진료 기록 작성&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#8A94A6&quot;&gt;진료 프로그램&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="1320" y="504" width="240" height="60" as="geometry"/></mxCell><mxCell id="a_r6" value="주의사항 종이 출력·전달&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#8A94A6&quot;&gt;시술별 주의사항 종이&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="720" y="604" width="240" height="60" as="geometry"/></mxCell><mxCell id="a_r7" value="밤에 전화·메시지로 문의" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="704" width="240" height="60" as="geometry"/></mxCell><mxCell id="a_r8" value="다음 날 아침 문서 찾아 답변&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#8A94A6&quot;&gt;주의사항 · 보험 기준 PDF&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#FFFFFF;strokeColor=#B85450;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="720" y="804" width="240" height="60" as="geometry"/></mxCell><mxCell id="a_r9" value="검진 대상 추출, 문자 직접 발송&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#8A94A6&quot;&gt;환자 엑셀 · 문자&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="720" y="1034" width="240" height="60" as="geometry"/></mxCell><mxCell id="a_r10" value="검진 문자 받음" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#FFFFFF;strokeColor=#333333;" vertex="1" parent="1"><mxGeometry x="420" y="1134" width="240" height="60" as="geometry"/></mxCell><mxCell id="a_n1" value="&lt;b&gt;병목 1 예약 겹침&lt;/b&gt;&lt;br&gt;“네이버 예약과 전화 예약을 옮겨 적다 보니 겹칠 때가 있어요” &lt;span style=&quot;color:#7A4B4A&quot;&gt;— 한 실장&lt;/span&gt;&lt;br&gt;&lt;b&gt;🎤&lt;/b&gt; 겹침 횟수는 안 셈, 발견하면 전화로 조정" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="990" y="192" width="285" height="104" as="geometry"/></mxCell><mxCell id="a_k_n1" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#B85450;" edge="1" parent="1" source="a_n1" target="a_r2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a_n2" value="&lt;b&gt;병목 2 준비물 착오&lt;/b&gt;&lt;br&gt;“시술마다 준비물이 달라서 예약 내용이 정확해야 해요” &lt;span style=&quot;color:#7A4B4A&quot;&gt;— 치과위생사&lt;/span&gt;&lt;br&gt;&lt;b&gt;🎤&lt;/b&gt; 환자가 온 뒤 확인하면 진료가 늦어짐" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1590" y="292" width="285" height="104" as="geometry"/></mxCell><mxCell id="a_k_n2" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#B85450;" edge="1" parent="1" source="a_n2" target="a_r3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a_n3" value="&lt;b&gt;병목 3 노쇼·시간 밀림&lt;/b&gt;&lt;br&gt;“예약 안 오시는 분이 하루 두세 명” &lt;span style=&quot;color:#7A4B4A&quot;&gt;— 한 실장&lt;/span&gt;&lt;br&gt;&lt;b&gt;🎤&lt;/b&gt; 진료가 길어져 뒤 예약이 밀림, 전날 문자도 꾸준히 못 보냄" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="1590" y="492" width="285" height="104" as="geometry"/></mxCell><mxCell id="a_k_n3" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#B85450;" edge="1" parent="1" source="a_n3" target="a_r5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a_n4" value="&lt;b&gt;병목 4 종이 분실&lt;/b&gt;&lt;br&gt;“환자가 주의사항 종이를 잃어버려서 밤에 전화가 와요” &lt;span style=&quot;color:#7A4B4A&quot;&gt;— 한 실장&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="990" y="592" width="285" height="84" as="geometry"/></mxCell><mxCell id="a_k_n4" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#B85450;" edge="1" parent="1" source="a_n4" target="a_r6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a_n5" value="&lt;b&gt;병목 5 밤에 물어도 아침까지 답을 못 받음&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#7A4B4A&quot;&gt;← 병목 6과 연결 (추론)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;dashed=1;" vertex="1" parent="1"><mxGeometry x="110" y="692" width="285" height="60" as="geometry"/></mxCell><mxCell id="a_k_n5" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#B85450;" edge="1" parent="1" source="a_n5" target="a_r7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a_n6" value="&lt;b style=&quot;color:#B85450&quot;&gt;★ 핵심&lt;/b&gt; &lt;b&gt;병목 6 밤 문의 지연&lt;/b&gt;&lt;br&gt;“밤에 오는 질문에 다음 날 아침까지 답을 못 해서 죄송해요” &lt;span style=&quot;color:#7A4B4A&quot;&gt;— 한 실장&lt;/span&gt;&lt;br&gt;&lt;b&gt;🎤&lt;/b&gt; 아침 업무가 답장부터 시작해 예약 확인·검진 안내가 밀림" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="990" y="792" width="285" height="112" as="geometry"/></mxCell><mxCell id="a_k_n6" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#B85450;" edge="1" parent="1" source="a_n6" target="a_r8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a_n7" value="&lt;b&gt;병목 7 보험 문의&lt;/b&gt;&lt;br&gt;“보험 되는지 묻는 전화가 많아요. 보험 기준이 해마다 조금씩 바뀌어요” &lt;span style=&quot;color:#7A4B4A&quot;&gt;— 한 실장&lt;/span&gt;&lt;br&gt;&lt;b&gt;🎤&lt;/b&gt; 올해 기준으로만 안내해야 함" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="990" y="900" width="285" height="104" as="geometry"/></mxCell><mxCell id="a_k_n7" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#B85450;" edge="1" parent="1" source="a_n7" target="a_r8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a_n8" value="&lt;b&gt;병목 8 검진 이탈&lt;/b&gt;&lt;br&gt;“정기 검진을 놓치면 그 환자는 다른 데로 가요” &lt;span style=&quot;color:#7A4B4A&quot;&gt;— 부원장&lt;/span&gt;&lt;br&gt;&lt;b&gt;🎤&lt;/b&gt; 검진 대상 수·예약률 집계 없음" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=middle;spacing=6;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="990" y="1022" width="285" height="104" as="geometry"/></mxCell><mxCell id="a_k_n8" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#B85450;" edge="1" parent="1" source="a_n8" target="a_r9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=12;" edge="1" parent="1" source="a_r1" target="a_r2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=12;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="a_r2" target="a_r3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a_e2" value="예약일" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=12;dashed=1;" edge="1" parent="1" source="a_r1" target="a_r4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=12;" edge="1" parent="1" source="a_r4" target="a_r5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=12;" edge="1" parent="1" source="a_r3" target="a_r5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a_e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=12;" edge="1" parent="1" source="a_r5" target="a_r6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a_e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=12;" edge="1" parent="1" source="a_r6" target="a_r7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a_e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=12;" edge="1" parent="1" source="a_r7" target="a_r8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a_e8" value="6개월 후" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=12;" edge="1" parent="1" source="a_r8" target="a_r9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a_e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#333333;fontSize=12;" edge="1" parent="1" source="a_r9" target="a_r10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a_leg" value="&lt;span style=&quot;color:#B85450&quot;&gt;■&lt;/span&gt; 빨간 박스 = 병목 (고객 자료 원문) · &lt;b&gt;🎤&lt;/b&gt; = 인터뷰로 새로 확인한 내용 · 빨간 점선 박스 = 환자가 겪는 영향(추론) · 굵은 테두리 = 핵심 병목 · 단계 아래 회색 글씨 = 쓰는 도구" style="text;html=1;fontSize=13;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="0" y="1250" width="1900" height="28" as="geometry"/></mxCell><mxCell id="a_rule" value="&lt;b&gt;📏 지켜야 할 규칙&lt;/b&gt;&lt;br&gt;1. 진료 기록은 원장·담당 위생사만 봄. 🎤 &lt;b&gt;데스크는 볼 수 없음&lt;/b&gt; — 대표 원장&lt;br&gt;2. 증상 질문엔 답하지 않음. 🎤 &lt;b&gt;진료 시간엔 병원 전화번호, 시간 외엔 응급 안내 문구&lt;/b&gt; — 대표 원장&lt;br&gt;3. 🎤 답변은 병원 자료(주의사항·보험 기준)의 일반 안내까지. 보험은 &lt;b&gt;올해 기준 우선&lt;/b&gt; — 대표 원장·한 실장&lt;br&gt;4. 주의사항은 시술끼리 섞이면 안 됨 — 치과위생사 · 5. 아이는 보호자 연락처, 어르신은 전화 — 원장·한 실장" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacing=8;fillColor=#FFF6E0;strokeColor=#E8C36A;" vertex="1" parent="1"><mxGeometry x="0" y="1284" width="1100" height="140" as="geometry"/></mxCell><mxCell id="a_want" value="&lt;b&gt;💬 고객이 바라는 것&lt;/b&gt;&lt;br&gt;환자가 자기 다음 예약과 받은 시술 목록을 볼 수 있으면 좋겠어요 — 부원장&lt;br&gt;&lt;br&gt;&lt;b&gt;🎤 고객에게 수치가 없는 것&lt;/b&gt;&lt;br&gt;예약·겹침 횟수, 밤 문의 비율, 검진 예약률 등 → 시스템이 기록하게 함" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;align=left;verticalAlign=top;spacing=8;fillColor=#F2F4F7;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="1130" y="1284" width="770" height="140" as="geometry"/></mxCell><mxCell id="secL" value="원인 분석 및 문제 정의 (Problem Definition)" style="rounded=0;html=1;fontSize=22;fontStyle=1;align=left;spacingLeft=12;fillColor=#1F2A44;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="1464" width="1900" height="44" as="geometry"/></mxCell><mxCell id="pdh" value="&lt;b&gt;“환자 노쇼 및 이탈의 핵심 원인은 데스크 인력 부족이 아니라, 파편화된 접점과 수작업 이관으로 인해 발생하는 ‘환자 케어 공백’과 ‘예약 데이터 정합성 오류’라는 시스템적 한계”&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=16;align=left;verticalAlign=middle;spacing=16;fillColor=#FFF6E0;strokeColor=#E8C36A;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="0" y="1524" width="1900" height="90" as="geometry"/></mxCell><mxCell id="pdt" value="&lt;b&gt;💡 3대 핵심 오퍼레이션 병목 세부 분석&lt;/b&gt;" style="text;html=1;fontSize=16;align=left;" vertex="1" parent="1"><mxGeometry x="0" y="1629" width="800" height="28" as="geometry"/></mxCell><mxCell id="th0" value="&lt;b&gt;접점&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontSize=14;fillColor=#E4E8EF;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="0" y="1664" width="160" height="36" as="geometry"/></mxCell><mxCell id="th1" value="&lt;b&gt;핵심 병목&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontSize=14;fillColor=#E4E8EF;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="160" y="1664" width="420" height="36" as="geometry"/></mxCell><mxCell id="th2" value="&lt;b&gt;현상 (원인)&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontSize=14;fillColor=#E4E8EF;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="580" y="1664" width="640" height="36" as="geometry"/></mxCell><mxCell id="th3" value="&lt;b&gt;결과&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontSize=14;fillColor=#E4E8EF;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="1220" y="1664" width="680" height="36" as="geometry"/></mxCell><mxCell id="td0_0" value="&lt;b&gt;1. [문의 접점]&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;spacing=10;fillColor=#F8CECC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="0" y="1700" width="160" height="80" as="geometry"/></mxCell><mxCell id="td0_1" value="&lt;b&gt;야간·휴일 환자 응대 공백&lt;br&gt;(Golden Time 이탈)&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;spacing=10;fillColor=#F8CECC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="160" y="1700" width="420" height="80" as="geometry"/></mxCell><mxCell id="td0_2" value="진료 종료 후 인플로우(Inflow)된 환자 문의에 대한 즉각적 대응 체계 부재" style="rounded=0;html=1;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;spacing=10;fillColor=#FFFFFF;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="580" y="1700" width="640" height="80" as="geometry"/></mxCell><mxCell id="td0_3" value="다음 날 아침 수동 응대로 인한 &lt;b&gt;환자의 정보 탐색 대기 시간 증가 및 타 병원 이탈&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;spacing=10;fillColor=#FFFFFF;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="1220" y="1700" width="680" height="80" as="geometry"/></mxCell><mxCell id="td1_0" value="&lt;b&gt;2. [안내 접점]&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;spacing=10;fillColor=#FFE6CC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="0" y="1780" width="160" height="80" as="geometry"/></mxCell><mxCell id="td1_1" value="&lt;b&gt;수동 리마인더 발송 누락&lt;br&gt;(No-Show 리스크)&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;spacing=10;fillColor=#FFE6CC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="160" y="1780" width="420" height="80" as="geometry"/></mxCell><mxCell id="td1_2" value="예약 확인 및 사전 검진 안내 문자의 데스크 수기 발송 의존" style="rounded=0;html=1;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;spacing=10;fillColor=#FFFFFF;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="580" y="1780" width="640" height="80" as="geometry"/></mxCell><mxCell id="td1_3" value="발송 타임라인 누락으로 인한 &lt;b&gt;선제적 환자 케어 부재 및 노쇼(No-Show)율 증가&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;spacing=10;fillColor=#FFFFFF;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="1220" y="1780" width="680" height="80" as="geometry"/></mxCell><mxCell id="td2_0" value="&lt;b&gt;3. [예약 접점]&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;spacing=10;fillColor=#DAE8FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="0" y="1860" width="160" height="80" as="geometry"/></mxCell><mxCell id="td2_1" value="&lt;b&gt;다채널 예약 수기 이관&lt;br&gt;(Data Integrity 오류)&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontSize=14;align=center;verticalAlign=middle;spacing=10;fillColor=#DAE8FC;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="160" y="1860" width="420" height="80" as="geometry"/></mxCell><mxCell id="td2_2" value="네이버 예약 및 전화 예약 건을 전자차트(EMR)로 수동 중복 입력" style="rounded=0;html=1;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;spacing=10;fillColor=#FFFFFF;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="580" y="1860" width="640" height="80" as="geometry"/></mxCell><mxCell id="td2_3" value="수기 이관 과정에서의 &lt;b&gt;예약 시술·시간대 중복 발생 및 재조정으로 인한 진료 지연&lt;/b&gt;" style="rounded=0;html=1;whiteSpace=wrap;fontSize=14;align=left;verticalAlign=middle;spacing=10;fillColor=#FFFFFF;strokeColor=#B8C0CC;" vertex="1" parent="1"><mxGeometry x="1220" y="1860" width="680" height="80" as="geometry"/></mxCell><mxCell id="secM" value="메뉴 구조도 (1단계 범위 · 구현 완료)" style="rounded=0;html=1;fontSize=22;fontStyle=1;align=left;spacingLeft=12;fillColor=#1F2A44;fontColor=#FFFFFF;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="2010" width="1900" height="44" as="geometry"/></mxCell><mxCell id="mp" value="&lt;b&gt;환자 웹앱 · 모바일&lt;/b&gt;" style="rounded=0;html=1;fontSize=15;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fillColor=#f7fbff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="0" y="2070" width="1900" height="400" as="geometry"/></mxCell><mxCell id="p1" value="P1 본인 확인&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;휴대폰 번호 + 휴대폰 주인(부모) 이름&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="20" y="2130" width="210" height="54" as="geometry"/></mxCell><mxCell id="p1r" value="거절: 등록된 환자가 아님 → 병원 전화번호 안내" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="2220" width="210" height="48" as="geometry"/></mxCell><mxCell id="p2" value="P2 홈&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;다음 예약 · 바로 상담&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fontStyle=1;fillColor=#6c8ebf;fontColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="260" y="2240" width="200" height="54" as="geometry"/></mxCell><mxCell id="p3" value="P3 AI 상담" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="520" y="2110" width="220" height="40" as="geometry"/></mxCell><mxCell id="p4" value="P4 내 예약" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="520" y="2182" width="220" height="40" as="geometry"/></mxCell><mxCell id="p5" value="P5 예약 신청" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="520" y="2254" width="220" height="40" as="geometry"/></mxCell><mxCell id="p6" value="P6 받은 시술 · 주의사항" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="520" y="2326" width="220" height="40" as="geometry"/></mxCell><mxCell id="p7" value="P7 알림함" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="520" y="2398" width="220" height="40" as="geometry"/></mxCell><mxCell id="p3a" value="P3-1 답변 + 근거 문서 · 쪽 표시&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;주의사항 · 보험(올해 기준)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="800" y="2104" width="330" height="52" as="geometry"/></mxCell><mxCell id="p3r" value="거절: 증상 질문 → 진료 시간엔 병원 전화번호, 시간 외엔 응급 안내&lt;br&gt;거절: 자료에 없음 → 데스크로 넘기고 다음 날 답변" style="rounded=1;whiteSpace=wrap;html=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="1180" y="2100" width="520" height="60" as="geometry"/></mxCell><mxCell id="p4a" value="P4-1 예약 상세 · 전날 확인 (갈게요 / 변경할게요)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="800" y="2182" width="330" height="40" as="geometry"/></mxCell><mxCell id="p5a" value="P5-1 누구 예약(본인 · 아이) → 시술 → 빈 시간" style="rounded=1;whiteSpace=wrap;html=1;fontSize=14;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="800" y="2254" width="330" height="40" as="geometry"/></mxCell><mxCell id="p5r" value="거절: 그 시간에 빈 의자 없음 → 다른 시간 선택" style="rounded=1;whiteSpace=wrap;html=